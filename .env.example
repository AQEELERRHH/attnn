# Copy to .env.local and fill in. Never commit real values.

# ─── Variables read via process.env in the code ─────────────────────────────

# Database (lib/db/client.ts, drizzle.config.ts)
DATABASE_URL=

# Auth: Google OAuth + Resend magic links (lib/auth.ts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=

# Circle Developer-Controlled Wallets (lib/circle.ts, app/api/wallet/balance)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# Optional: overrides the default https://api.circle.com when fetching webhook public keys
CIRCLE_API_BASE_URL=

# Arc contracts (lib/agent.ts, inngest/functions.ts, app/api/bid/*, app/api/profile/activate)
ATTN_REGISTRY_CONTRACT=
ATTN_ESCROW_CONTRACT=
ATTN_USDC_ADDRESS=

# AISA AI scoring (lib/ai.ts)
AISA_API_URL=
AISA_API_KEY=
AISA_MODEL=

# Inngest (lib/inngest.ts)
INNGEST_EVENT_KEY=

# x402 nanopayment gate (lib/x402.ts, app/api/x402/access)
SELLER_ADDRESS=
X402_MOCK=
ENABLE_X402_MIDDLEWARE=

# Webhook signature secret (app/api/webhooks/arc). Required: the route fails closed without it.
# Circle webhooks (app/api/webhooks/circle, app/api/webhooks/circle-events) need no shared
# secret. They are verified against Circle's notification public key API using CIRCLE_API_KEY.
ALCHEMY_WEBHOOK_SECRET=

# ─── Not referenced directly in the code, but read by libraries or scripts ───

# Auth.js v5 (next-auth reads these implicitly)
NEXTAUTH_SECRET=
NEXTAUTH_URL=
AUTH_TRUST_HOST=

# Inngest serve handler (app/api/inngest) verifies requests with this
INNGEST_SIGNING_KEY=

# npm run deploy:contracts (package.json script)
ARC_RPC_DEPLOY=
DEPLOYER_PRIVATE_KEY=
